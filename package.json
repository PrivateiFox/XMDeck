{
  "name": "xmdeck",
  "version": "0.1.1",
  "description": "Sony WH/WF-1000XM headphones control and monitoring for Steam Deck",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "decky-plugin",
    "sony",
    "bluetooth",
    "headphones",
    "anc",
    "ambient-sound"
  ],
  "author": "PrivateiFox",
  "license": "GPL-3.0",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
